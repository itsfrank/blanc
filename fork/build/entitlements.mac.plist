<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- fork(0001): upstream's build/entitlements.mac.plist without the Touch ID
       passkey entitlements (keychain-access-groups, application-identifier,
       team-identifier). macOS kills an app carrying those unless the owner's
       provisioning profile authorizes them, and a personal build has none. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- fork(0001): a self-signed or ad-hoc signature has no Apple Team ID, so
       under the hardened runtime macOS refuses to load the app's own Electron
       framework ("different Team IDs"). Turning off library validation keeps
       the hardened runtime's other protections. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
